{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "goouts-f16db",
          "appId": "1:289872853637:android:d68b6be59f594c755bc7ec",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "goouts-f16db",
          "configurations": {
            "android": "1:289872853637:android:d68b6be59f594c755bc7ec",
            "ios": "1:289872853637:ios:5f8f0bd5bb33d1365bc7ec",
            "macos": "1:289872853637:ios:5f8f0bd5bb33d1365bc7ec",
            "web": "1:289872853637:web:7461195d14c1f92b5bc7ec",
            "windows": "1:289872853637:web:b6797a23ccc40d995bc7ec"
          }
        }
      }
    }
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "//": "Added 9 September 2026 for the web version of this app (Short",
    "//2": "Stay booking first, food ordering next). This is the SAME app,",
    "//3": "compiled with `flutter build web` into build/web, not a",
    "//4": "separate codebase to maintain.",
    "site": "goouts-book",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "//": "Broad no-cache FIRST, same reasoning as goouts_website's",
        "//2": "firebase.json: '**' matches every path including '/', so a",
        "//3": "site update is never served stale from cache. Flutter's own",
        "//4": "web output does not hash main.dart.js's filename between",
        "//5": "builds, so hard-caching it here would risk an old cached JS",
        "//6": "file paired with a new index.html after a real deploy.",
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          }
        ]
      },
      {
        "//": "Only genuinely static image assets are cached hard.",
        "source": "assets/**/*.@(jpg|jpeg|png|webp|gif|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}